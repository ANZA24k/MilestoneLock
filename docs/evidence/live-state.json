      "specification": {
        "criteria": [
          {
            "id": "form_labels",
            "requirement": "The contact form must associate a visible Email label with an email input using matching for and id attributes."
          },
          {
            "id": "keyboard_submit",
            "requirement": "The form must include a native submit button reachable in normal keyboard tab order, without a negative tabindex."
          },
          {
            "id": "required_email",
            "requirement": "The email input must use type=email and the required attribute to prevent an empty submission."
          }
        ],
        "deliverable": "Deliver a small accessible landing page with a contact form and reproducible validation output.",
